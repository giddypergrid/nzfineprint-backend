# supercronic schedule. Five fields: minute hour day-of-month month day-of-week.
# 0 0 * * *  ->  minute 0 of hour 0, every day = 00:00 daily.
# The hour is in the container's TZ (Pacific/Auckland, set on the updater service), so this is
# midnight NZ even when the host server runs UTC.
0 0 * * * sh /app/run_update.sh
