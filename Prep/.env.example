# Copy to .env and fill in. Register a free key at https://digitalnz.org/developers
# Optional — the API works keyless, but unauthenticated requests are rate-limited.
DIGITALNZ_API_KEY=

# https://platform.deepseek.com/api_keys — used by pipeline/enrich.py
DEEPSEEK_API_KEY=

# https://deepinfra.com — hosted bge-large-en-v1.5 for query embedding (app/ search). Must match EMBED_MODEL.
EMBED_API_KEY=
